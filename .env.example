# ==========================================
# Nexofood Frontend - Environment Variables
# ==========================================

# URL pública de la API Backend (Accesible tanto desde el cliente como desde el servidor)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# URL interna de la API Backend (Opcional: para comunicación directa Server-to-Server si se usa Docker / red interna)
API_INTERNAL_URL=http://localhost:8080/api/v1

# Public Key de Mercado Pago de la plataforma para cobro directo de suscripciones con CardForm
# (Opcional: si se deja vacío, el frontend obtiene la clave dinámicamente desde GET /subscriptions/config)
NEXT_PUBLIC_MP_PUBLIC_KEY=

# --- Producción (https://nexofood-app.com) ---
# NEXT_PUBLIC_API_URL=https://api.nexofood-app.com/api/v1
# API_INTERNAL_URL=https://api.nexofood-app.com/api/v1

